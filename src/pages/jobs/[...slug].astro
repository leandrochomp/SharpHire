---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkTypeBadge from '../../components/WorkTypeBadge.astro';
import TechTags from '../../components/TechTags.astro';
import { SITE } from '../../config';
import { formatDateAU, isoDate } from '../../lib/dates';
import { getOpenJobs } from '../../lib/jobs';
import { formatSalary } from '../../lib/salary';
import { excerpt } from '../../lib/text';
import { withBase } from '../../lib/url';

export const getStaticPaths = (async () => {
  const jobs = await getOpenJobs();
  return jobs.map((job) => ({ params: { slug: job.id }, props: { job } }));
}) satisfies GetStaticPaths;

const { job } = Astro.props;
const { title, company, location, salaryMinAUD, salaryMaxAUD, workType, techStack, closingDate } = job.data;
const { Content } = await render(job);

const subject = `Application: ${title} (${company})`;
const applyHref = `mailto:${SITE.contactEmail}?subject=${encodeURIComponent(subject)}`;
---

<BaseLayout title={`${title} — ${company} | ${SITE.name}`} description={excerpt(job.body ?? '')} ogType="article">
  <a href={withBase('/')} class="text-sm text-accent-700 hover:underline">← All jobs</a>

  <article class="mt-4 rounded-lg border border-slate-200 bg-white p-6 sm:p-8">
    <header class="border-b border-slate-200 pb-6">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div>
          <h1 class="text-2xl font-bold tracking-tight sm:text-3xl">{title}</h1>
          <p class="mt-1 text-lg text-slate-600">{company}</p>
        </div>
        <WorkTypeBadge workType={workType} />
      </div>

      <dl class="mt-6 grid gap-4 text-sm sm:grid-cols-3">
        <div>
          <dt class="text-slate-500">Location</dt>
          <dd class="font-medium">{location}</dd>
        </div>
        <div>
          <dt class="text-slate-500">Salary (base, excl. super)</dt>
          <dd class="font-medium">{formatSalary(salaryMinAUD, salaryMaxAUD)}</dd>
        </div>
        <div>
          <dt class="text-slate-500">Closes</dt>
          <dd class="font-medium"><time datetime={isoDate(closingDate)}>{formatDateAU(closingDate)}</time></dd>
        </div>
      </dl>

      <TechTags tags={techStack} class="mt-6" />
    </header>

    <div class="job-body mt-6">
      <Content />
    </div>

    <footer class="mt-8 border-t border-slate-200 pt-6">
      <a href={applyHref} class="inline-block rounded-md bg-accent-600 px-5 py-2.5 font-medium text-white hover:bg-accent-700">
        Apply via {SITE.name}
      </a>
      <p class="mt-2 text-sm text-slate-500">Opens your email app. Attach your CV and we'll be in touch.</p>
    </footer>
  </article>
</BaseLayout>
