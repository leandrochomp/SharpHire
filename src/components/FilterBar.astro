---
import { WORK_TYPES, WORK_TYPE_LABELS } from '../lib/filterJobs';
import { REMOTE } from '../lib/location';

interface Props {
  /** Location keys present in the data (state codes and/or "Remote"). */
  locations: string[];
}

const { locations } = Astro.props;
const selectClass =
  'mt-1 block w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-slate-900 focus:border-accent-600 focus:outline-2 focus:outline-accent-600';
---

<!-- Hidden until JS runs: without JS every job is simply listed. -->
<form id="job-filters" hidden class="mb-6 grid gap-4 rounded-lg border border-slate-200 bg-white p-4 sm:grid-cols-[1fr_1fr_auto] sm:items-end">
  <label class="block text-sm font-medium text-slate-700">
    Location
    <select name="location" class={selectClass}>
      <option value="">All locations</option>
      {locations.map((loc) => <option value={loc}>{loc === REMOTE ? 'Remote (anywhere)' : loc}</option>)}
    </select>
  </label>
  <label class="block text-sm font-medium text-slate-700">
    Work type
    <select name="workType" class={selectClass}>
      <option value="">All work types</option>
      {WORK_TYPES.map((type) => <option value={type}>{WORK_TYPE_LABELS[type]}</option>)}
    </select>
  </label>
  <button type="reset" class="rounded-md px-3 py-2 text-sm font-medium text-accent-700 hover:bg-accent-50">
    Clear filters
  </button>
</form>
