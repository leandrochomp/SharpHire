---
import type { CollectionEntry } from 'astro:content';
import { formatDateAU } from '../lib/dates';
import { locationKey } from '../lib/location';
import { formatSalary } from '../lib/salary';
import { withBase } from '../lib/url';
import WorkTypeBadge from './WorkTypeBadge.astro';
import TechTags from './TechTags.astro';

interface Props {
  job: CollectionEntry<'jobs'>;
}

const { job } = Astro.props;
const { title, company, location, salaryMinAUD, salaryMaxAUD, workType, techStack, closingDate } = job.data;
---

<li data-job data-location={locationKey(location)} data-work-type={workType}>
  <a
    href={withBase(`jobs/${job.id}/`)}
    class="block rounded-lg border border-slate-200 bg-white p-5 shadow-sm transition hover:border-accent-600 hover:shadow focus-visible:outline-2 focus-visible:outline-accent-600"
  >
    <div class="flex flex-wrap items-start justify-between gap-2">
      <div>
        <h2 class="text-lg font-semibold text-slate-900">{title}</h2>
        <p class="text-slate-600">{company} · {location}</p>
      </div>
      <WorkTypeBadge workType={workType} />
    </div>
    <p class="mt-3 font-medium text-slate-800">{formatSalary(salaryMinAUD, salaryMaxAUD)}</p>
    <TechTags tags={techStack} class="mt-3" />
    <p class="mt-3 text-sm text-slate-500">Closes {formatDateAU(closingDate)}</p>
  </a>
</li>
